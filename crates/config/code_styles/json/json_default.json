{
  "language": "json",
  "name": "JSON",
  "indent": { "style": "spaces", "size": 2 },
  "braces": { "classes": "same_line", "functions": "same_line", "control_structures": "same_line" },
  "spacing": { "around_operators": true, "after_comma": true, "inside_parentheses": false },
  "empty_lines": { "after_namespace": 1, "between_methods": 1 }
}
